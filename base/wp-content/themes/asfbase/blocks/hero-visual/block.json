{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "asfbase/hero-visual",
	"title": "ASF Base Hero visual",
	"category": "theme",
	"icon": "art",
	"description": "One real client image. Optional results card: set photoCase to a case study slug and photoChip to its label.",
	"attributes": {
		"photoCase": { "type": "string", "default": "" },
		"photoChip": { "type": "string", "default": "" },
		"image": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "multiple": false },
	"textdomain": "asfbase",
	"editorScript": "asfbase-editor-blocks",
	"render": "file:./render.php"
}
