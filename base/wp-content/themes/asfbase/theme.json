{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "ink", "name": "Ink (text, dark panels)", "color": "#222222" },
				{ "slug": "ink-2", "name": "Ink raised", "color": "#333333" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "mist", "name": "Mist (soft section)", "color": "#F2F2F2" },
				{ "slug": "accent", "name": "Accent (placeholder)", "color": "#555555" },
				{ "slug": "muted", "name": "Muted text", "color": "#5C5C5C" }
			],
			"gradients": [
				
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{ "slug": "display", "name": "System (placeholder)", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif" },
				{ "slug": "sans", "name": "System", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "S", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Body", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "medium", "name": "Lead", "size": "1.3125rem", "fluid": { "min": "1.125rem", "max": "1.3125rem" } },
				{ "slug": "large", "name": "H3", "size": "1.625rem", "fluid": { "min": "1.3125rem", "max": "1.625rem" } },
				{ "slug": "x-large", "name": "H2", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "H1", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } },
				{ "slug": "hero", "name": "Hero", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw", "vh" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "3XS", "size": "0.5rem" },
				{ "slug": "20", "name": "2XS", "size": "0.75rem" },
				{ "slug": "30", "name": "XS", "size": "1rem" },
				{ "slug": "40", "name": "S", "size": "clamp(1.25rem, 2vw, 1.5rem)" },
				{ "slug": "50", "name": "M", "size": "clamp(1.5rem, 3vw, 2.5rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(2.5rem, 5vw, 4rem)" },
				{ "slug": "70", "name": "XL", "size": "clamp(4.5rem, 8vw, 7.5rem)" },
				{ "slug": "80", "name": "2XL", "size": "clamp(5rem, 11vw, 10rem)" }
			]
		},
		"custom": {
			"gutter": "clamp(1.25rem, 4vw, 2.5rem)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "var(--wp--custom--gutter)", "right": "var(--wp--custom--gutter)" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "700", "lineHeight": "1.15" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "currentColor" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "var(--wp--preset--color--white)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "0.9688rem", "fontWeight": "600", "lineHeight": "1" },
				"border": { "radius": "4px" }
			},
			"caption": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-prose", "title": "Text page (title + prose)", "postTypes": [ "page" ] }
	]
}
