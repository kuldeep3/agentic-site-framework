# WordPress core, SQLite database and uploads are generated by bin/setup.sh
/wordpress/
.DS_Store
*.log

# Settings for this machine only (`bin/asf set --local site_url …`): each person's local site address differs.
/asf.local.json

# Raw client material for /asf intake (emails, call transcripts, notes): private, never committed.
# The folder itself is kept (.gitkeep) so every clone has it.
/docs/intake/raw/*
!/docs/intake/raw/.gitkeep

# Call and meeting recordings live on the team's shared drive, never in the repo.
/docs/**/*.mp3
/docs/**/*.m4a
/docs/**/*.wav
/docs/**/*.aac
/docs/**/*.ogg
/docs/**/*.flac
/docs/**/*.mp4
/docs/**/*.mov
/docs/**/*.webm
/docs/**/*.mkv
/docs/**/*.avi
